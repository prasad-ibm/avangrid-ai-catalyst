# Copy this file to .env and fill in real values. NEVER commit .env.
#
# Postgres connection string. On Railway, set this to the service reference:
#   DATABASE_URL=${{ Postgres.DATABASE_URL }}
# For local dev, use the PUBLIC proxy URL from Railway (host ends in .proxy.rlwy.net).
DATABASE_URL=postgresql://user:password@host:port/dbname

# Port the server listens on. Defaults to 3000 if unset (Railway injects its own).
PORT=3000

# Secret used to sign session cookies. Generate a long random string for production:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# ============================================================================
#  Azure OpenAI  (optional — powers the live Executive Panel + AI Assist)
# ----------------------------------------------------------------------------
#  Leave AI_PROVIDER=scripted (or unset) to run fully offline with the built-in
#  deterministic content — no key, no cost. Set a provider below to go live.
#
#  AI_PROVIDER options:  scripted | azure
# ============================================================================
AI_PROVIDER=scripted

# --- Azure OpenAI resource -------------------------------------------------
#  In the Azure Portal, create an Azure OpenAI resource and deploy a chat model
#  (e.g. gpt-4o-mini). Then set AI_PROVIDER=azure and fill in the values below.
#
#  ENDPOINT   — the resource endpoint, e.g. https://my-resource.openai.azure.com
#  API_KEY    — Keys and Endpoint blade (sent as the api-key header)
#  DEPLOYMENT — the deployment NAME you chose (not the base model id)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-06-01
